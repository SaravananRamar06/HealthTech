# Copy to .env.local for local development. Never commit real values.
# All of these are server-only. Never prefix them with NEXT_PUBLIC_.

# Google AI Studio API key (P2: document extraction)
GEMINI_API_KEY=
# Exact Flash-tier model ID copied from AI Studio
GEMINI_MODEL=

# Upstash Redis (P3: share records). If unset, an in-memory store is used (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
